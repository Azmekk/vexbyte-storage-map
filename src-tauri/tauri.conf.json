{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vexbyte Storage Map",
  "mainBinaryName": "VexbyteStorageMap",
  "version": "0.1.0",
  "identifier": "com.vexbyte.storagemap",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vexbyte Storage Map",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Vexbyte",
    "category": "Utility",
    "shortDescription": "Disk space explorer and duplicate finder",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
